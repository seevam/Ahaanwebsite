# Public site URL (canonical + Open Graph)
PUBLIC_SITE_URL=https://example.com
# Plausible domain; leave empty to disable analytics
PUBLIC_PLAUSIBLE_DOMAIN=
# Pre-launch email capture endpoint (Formspree/Tally/etc.)
PUBLIC_NOTIFY_FORM_URL=
# Store listings; leave empty until the app is published
PUBLIC_PLAY_STORE_URL=
PUBLIC_APP_STORE_URL=
PUBLIC_CONTACT_EMAIL=hello@example.com
# Set to "true" only once real, permissioned testimonials exist
PUBLIC_SHOW_TESTIMONIALS=false
