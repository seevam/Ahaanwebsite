---
import Base from '../layouts/Base.astro';
import PhoneMock from '../components/PhoneMock.astro';
import Download from '../components/Download.astro';
import { site } from '../config/site';
import { getDict } from '../i18n';
const t = getDict();
const a = t.about;
---
<Base title={t.meta.aboutTitle} description={t.meta.aboutDescription}>
  <div class="section">
    <div class="container-page prose-page space-y-16">
      <section aria-labelledby="about-h" class="flex flex-col gap-6 sm:flex-row sm:items-center">
        <!-- Replace with a real photo only after Ahaan and his parents approve. -->
        <svg role="img" aria-label={a.photoAlt} class="h-40 w-40 shrink-0 rounded-full bg-primary-tint text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="9" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg>
        <div>
          <h1 id="about-h" class="text-4xl">{a.title}</h1>
          <p class="mt-3 text-xl">{a.summary}</p>
        </div>
      </section>

      <section aria-labelledby="story-h">
        <h2 id="story-h" class="text-3xl">{a.storyTitle}</h2>
        {a.story.map((p) => <p class="mt-4">{p}</p>)}
      </section>

      <section aria-labelledby="built-h">
        <h2 id="built-h" class="text-3xl">{a.builtTitle}</h2>
        <p class="mt-4">{a.builtText}</p>
        <div class="mt-6"><PhoneMock alt={a.builtAlt} variant="home" /></div>
        <p class="mt-6"><a class="link font-bold" href="/#features">{a.builtLink}</a></p>
      </section>

      <section aria-labelledby="cta-h">
        <h2 id="cta-h" class="text-3xl">{a.ctaTitle}</h2>
        <p class="mt-4">{a.ctaText} <a class="link" href={`mailto:${site.email}`}>{site.email}</a></p>
      </section>
    </div>
  </div>
  <Download />
</Base>
