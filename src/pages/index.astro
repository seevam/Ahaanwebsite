---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneMock from '../components/PhoneMock.astro';
import Download from '../components/Download.astro';
import Video from '../components/Video.astro';
import Testimonials from '../components/Testimonials.astro';
import { getDict } from '../i18n';
const t = getDict();
const problemIcons = ['clock', 'timer', 'bottle'];
const stepVariants = ['add', 'alarm', 'caregiver'] as const;
---
<Base title={t.meta.homeTitle} description={t.meta.homeDescription}>
  <section class="section bg-primary-tint" aria-labelledby="hero-h">
    <div class="container-page grid items-center gap-10 md:grid-cols-2">
      <div>
        <h1 id="hero-h" class="text-4xl sm:text-5xl">{t.hero.title}</h1>
        <p class="mt-5 max-w-xl text-xl">{t.hero.subtitle}</p>
        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <a href="#download" class="btn btn-primary">{t.hero.primary}</a>
          <a href="#solution" class="link font-bold">{t.hero.secondary}</a>
        </div>
      </div>
      <PhoneMock alt={t.hero.mockAlt} variant="home" />
    </div>
  </section>

  <section id="problem" class="section" aria-labelledby="problem-h">
    <div class="container-page">
      <h2 id="problem-h" class="text-3xl sm:text-4xl">{t.problem.title}</h2>
      <p class="mt-4 max-w-3xl">{t.problem.text}</p>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {t.problem.cards.map((c, i) => (
          <li class="card"><span class="text-primary"><Icon name={problemIcons[i]} /></span><h3 class="mt-3 text-xl">{c.title}</h3><p class="mt-2">{c.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="solution" class="section bg-surface" aria-labelledby="solution-h">
    <div class="container-page">
      <h2 id="solution-h" class="text-3xl sm:text-4xl">{t.solution.title}</h2>
      <p class="mt-4 max-w-3xl">{t.solution.text}</p>
      <ol class="mt-10 grid gap-10 md:grid-cols-3">
        {t.solution.steps.map((s, i) => (
          <li class="text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary text-xl font-bold text-white" aria-hidden="true">{i + 1}</span>
            <h3 class="mt-3 text-xl"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p class="mt-2">{s.text}</p>
            <div class="mt-6"><PhoneMock alt={s.alt} variant={stepVariants[i]} /></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Video />

  <section id="features" class="section" aria-labelledby="features-h">
    <div class="container-page">
      <h2 id="features-h" class="text-3xl sm:text-4xl">{t.features.title}</h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {t.features.items.map((f) => (
          <li class="card"><span class="text-primary"><Icon name={f.icon} /></span><h3 class="mt-3 text-xl">{f.title}</h3><p class="mt-2">{f.text}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <Testimonials />
  <Download />
</Base>
