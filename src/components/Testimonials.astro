---
import { site, testimonials } from '../config/site';
import { getDict } from '../i18n';
const t = getDict().testimonials;
const show = site.showTestimonials && testimonials.length > 0;
---
{show && (
  <section id="testimonials" class="section" aria-labelledby="testi-h">
    <div class="container-page">
      <h2 id="testi-h" class="text-center text-3xl sm:text-4xl">{t.title}</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {testimonials.slice(0, 3).map((x) => (
          <li class="card"><blockquote>“{x.quote}”</blockquote><p class="mt-4 font-bold">{x.name}, {x.role}</p></li>
        ))}
      </ul>
    </div>
  </section>
)}
